{
  "appId": "com.prvlar.app",
  "productName": "Prvlar",
  "artifactName": "Prvlar-${version}-windows-${arch}.${ext}",
  "files": [
    {
      "from": "dist-web",
      "to": "dist",
      "filter": [
        "**/*"
      ]
    },
    "electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "directories": {
    "output": "release-public"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/electron/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "artifactName": "Prvlar-${version}-windows-setup.${ext}",
    "include": "resources/electron/migrate-old.nsh",
    "installerSidebar": "resources/electron/installerSidebar.bmp",
    "uninstallerSidebar": "resources/electron/installerSidebar.bmp"
  }
}
