{
  "hosting": {
    "public": "dist-web",
    "ignore": ["firebase.json", "**/.*"],
    "trailingSlash": true,
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
    ]
  }
}
